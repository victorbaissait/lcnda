{
  "name": "carnet-numerique-ancetres",
  "productName": "LCNDA",
  "version": "0.1.0",
  "description": "Application de généalogie locale (PHP + SQLite) dans une fenêtre de bureau. Pensée et designée par Victor Baissait, codée par Codex (ChatGPT) et Claude.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:local": "electron . --use-project-data",
    "test:php": "node electron/test-php-server.js",
    "fetch:php": "node electron/fetch-php.js",
    "fetch:geo": "node electron/fetch-geo.js",
    "test:migrations": "node tests/test-migrations.js",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:mac-arm64": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64 --arm64",
    "test:gedcom": "node tests/test-gedcom.js",
    "test:import": "node tests/test-import.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Victor Baissait"
  },
  "build": {
    "appId": "org.carnet-numerique-des-ancetres.app",
    "productName": "LCNDA",
    "copyright": "Copyright © 2026 Victor Baissait — AGPL-3.0-or-later",
    "directories": {
      "output": "dist",
      "buildResources": "electron/build"
    },
    "asar": true,
    "files": [
      "package.json",
      "electron/main.js",
      "electron/php-server.js",
      "electron/preload.js",
      "electron/loading.html"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "php-app",
        "filter": [
          "api.php",
          "index.php",
          "upload.php",
          "router.php",
          "telecharger.php",
          "carnet-numerique-des-ancetres.php",
          "LICENSE",
          "lib/**/*",
          "assets/**/*",
          "config/**/*",
          "data/schema.sql",
          "data/reference/geo-*.sqlite.gz",
          "!**/.DS_Store"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "afterPack": "electron/build/hooks.js",
    "mac": {
      "category": "public.app-category.reference",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "artifactName": "LCNDA-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "LCNDA ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "LCNDA-${version}-windows-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/vcredist/vc_redist.x64.exe",
          "to": "vc_redist.x64.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "shortcutName": "LCNDA",
      "uninstallDisplayName": "LCNDA — Carnet numérique des ancêtres",
      "include": "electron/build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Victor Baissait",
      "artifactName": "LCNDA-${version}-linux-${arch}.${ext}",
      "executableName": "lcnda",
      "desktop": {
        "entry": {
          "Name": "LCNDA",
          "GenericName": "Carnet numérique des ancêtres",
          "Comment": "Carnet numérique des ancêtres : généalogie locale (personnes, actes, images et archives)"
        }
      }
    },
    "publish": null
  }
}
